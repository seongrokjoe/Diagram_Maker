<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the already provisioned SDK's NuGet content-hash algorithm. -->
    <Reference Include="NuGet.Packaging" HintPath="$(MSBuildToolsPath)/NuGet.Packaging.dll" />
    <Reference Include="NuGet.Frameworks" HintPath="$(MSBuildToolsPath)/NuGet.Frameworks.dll" />
  </ItemGroup>
</Project>
