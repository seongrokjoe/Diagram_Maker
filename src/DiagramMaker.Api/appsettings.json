{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",
  "Storage": {
    "Provider": "LocalFile",
    "LocalFilePath": "../../data/repositories.json",
    "ConnectionString": "Host=postgres;Port=5432;Database=diagram_maker;Username=diagram_maker;Password=change-me"
  },
  "Security": {
    "TrustReverseProxyHeaders": false,
    "AnalysisRetentionDays": 30,
    "AuditRetentionDays": 180
  },
  "GitWorker": {
    "NodeExecutable": "node",
    "ScriptPath": "../../tools/git-worker/index.mjs",
    "MaxChangedFiles": 200,
    "MaxTextFileBytes": 1000000,
    "TimeoutSeconds": 120
  },
  "Llm": {
    "Enabled": false,
    "AllowDevelopmentStub": true,
    "BaseUrl": "http://internal-llm.company.local",
    "ChatPath": "/v1/chat/completions",
    "Model": "internal-code-model",
    "AllowedHosts": [
      "internal-llm.company.local"
    ],
    "SupportsJsonSchema": true,
    "TimeoutSeconds": 90,
    "MaxInputCharacters": 60000
  }
}
