{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",
  "Storage": {
    "Provider": "LocalFile",
    "LocalFilePath": "../../data/repositories.json",
    "ConnectionString": "Host=postgres;Port=5432;Database=diagram_maker;Username=diagram_maker;Password=change-me"
  },
  "Security": {
    "TrustReverseProxyHeaders": false,
    "AnalysisRetentionDays": 30,
    "AuditRetentionDays": 180
  },
  "GitWorker": {
    "NodeExecutable": "node",
    "ScriptPath": "../../tools/git-worker/index.mjs",
    "MaxChangedFiles": 200,
    "MaxTextFileBytes": 1000000,
    "TimeoutSeconds": 120
  },
  "Llm": {
    "Enabled": false,
    "AllowDevelopmentStub": true,
    "Endpoint": "https://llm.invalid/v1/chat/completions",
    "AllowedOrigin": "https://llm.invalid",
    "Model": "internal-code-model",
    "ConnectTimeoutSeconds": 120,
    "NoResponseTimeoutSeconds": 120,
    "RequestTimeoutSeconds": 300,
    "DiagramOutputTokens": 16000,
    "ReviewOutputTokens": 8000,
    "ThinkingOutputTokens": 60000,
    "OutputHardLimit": 60000,
    "MaxInputCharacters": 60000,
    "MaxTransientRetries": 1
  }
}
